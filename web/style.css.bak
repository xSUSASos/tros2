:root {
  --bg: #14171c; --panel: #1b1f26; --line: #2a3039; --ink: #e6e9ef;
  --dim: #8b95a5; --accent: #4da3ff; --ok: #37c26b; --warn: #e5a13a;
  --fault: #e0524a; --grid: #232932;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--ink);
  font: 14px/1.45 "Segoe UI", system-ui, sans-serif;
}
header {
  display: flex; align-items: center; gap: 16px;
  padding: 10px 16px; background: var(--panel); border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 10px; font-size: 16px; }
.status { display: flex; gap: 8px; margin-left: auto; }
.chip {
  padding: 4px 10px; border-radius: 12px; background: var(--bg);
  border: 1px solid var(--line); font-size: 12px; color: var(--dim);
}
.chip.ok { color: var(--ok); border-color: var(--ok); }
.chip.warning { color: var(--warn); border-color: var(--warn); }
.chip.fault, .chip.estop { color: var(--fault); border-color: var(--fault); }
.badge {
  padding: 2px 8px; border-radius: 4px; font-size: 11px; letter-spacing: .04em;
  background: #2b3a4d; color: #9ec7ff;
}
.badge.warn { background: #4a3a1c; color: #f0c274; }
.estop {
  background: var(--fault); color: #fff; border: none; border-radius: 8px;
  padding: 10px 18px; font-weight: 700; font-size: 13px; line-height: 1.1;
  cursor: pointer; box-shadow: 0 0 0 3px #4a1a17;
}
.estop:hover { filter: brightness(1.1); }
.estop.armed { background: #6b2b26; }

.banner {
  padding: 8px 16px; background: #3a2320; color: #ffb4ad;
  border-bottom: 1px solid var(--fault); font-size: 13px; white-space: pre-wrap;
}
.hidden { display: none !important; }

main { display: grid; grid-template-columns: minmax(560px, 1fr) 460px; gap: 12px; padding: 12px; }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px; }
canvas { width: 100%; height: auto; background: #101317; border-radius: 8px; display: block; }

.tabs { display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; align-items: center; }
.tab {
  background: transparent; border: 1px solid var(--line); color: var(--dim);
  padding: 5px 12px; border-radius: 6px; cursor: pointer; font-size: 13px;
}
.tab.active { color: var(--ink); border-color: var(--accent); background: #1f2937; }
.tabpage { display: none; }
.tabpage.active { display: block; }

h3 { margin: 16px 0 8px; font-size: 13px; color: var(--dim); text-transform: uppercase; letter-spacing: .05em; }
.row { display: flex; gap: 8px; align-items: center; margin: 8px 0; flex-wrap: wrap; }
.row .grow { flex: 1; }
button {
  background: #232a34; color: var(--ink); border: 1px solid var(--line);
  border-radius: 6px; padding: 7px 12px; cursor: pointer; font-size: 13px;
}
button:hover:not(:disabled) { border-color: var(--accent); }
button:disabled { opacity: .4; cursor: not-allowed; }
button.big { flex: 1; padding: 11px; font-weight: 600; }
button.ghost { background: transparent; }
button.toggle.on { background: #1e4a2c; border-color: var(--ok); color: #b6f0c9; }
input[type=number], input[type=text], textarea {
  background: #10141a; color: var(--ink); border: 1px solid var(--line);
  border-radius: 5px; padding: 6px 8px; font: inherit; width: 100%;
}
label { color: var(--dim); font-size: 12px; }
label.inline { display: flex; align-items: center; gap: 5px; }
.unit { color: var(--dim); font-size: 12px; margin-left: 4px; }
.hint { color: var(--dim); font-size: 12px; margin: 4px 0; }

.readout { display: flex; gap: 18px; margin-top: 10px; flex-wrap: wrap; }
.readout div { display: flex; flex-direction: column; }
.readout span { color: var(--dim); font-size: 11px; text-transform: uppercase; }
.readout b { font-size: 18px; font-variant-numeric: tabular-nums; }

.jog { display: flex; gap: 14px; align-items: center; }
.pad {
  display: grid; grid-template-columns: repeat(3, 62px); grid-template-rows: repeat(3, 62px);
  gap: 4px;
}
.j {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 17px; padding: 0; line-height: 1;
}
.j small { font-size: 10px; color: var(--dim); margin-top: 2px; }
.up { grid-area: 1/2; } .left { grid-area: 2/1; } .home { grid-area: 2/2; }
.right { grid-area: 2/3; } .down { grid-area: 3/2; }
.zcol { display: grid; grid-template-rows: 62px 62px; gap: 4px; width: 62px; }
.steps { display: flex; gap: 5px; margin-top: 10px; align-items: center; }
.steps button { min-width: 46px; }
.steps button.active { border-color: var(--accent); background: #1f2937; }

.mdi { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; align-items: end; }
.mdi button { grid-column: span 2; }

.slider { display: flex; align-items: center; gap: 10px; }
.slider input { flex: 1; }
#tension-value { font-variant-numeric: tabular-nums; min-width: 54px; }
.cable { display: grid; grid-template-columns: 34px 1fr 60px; gap: 8px; align-items: center; margin: 4px 0; }
.bar { height: 14px; background: #10141a; border-radius: 3px; position: relative; overflow: hidden; }
.bar i { position: absolute; inset: 0 auto 0 0; background: var(--ok); }
.bar i.low { background: var(--warn); } .bar i.high { background: var(--fault); }
.bar u { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--accent); }
.cable span { color: var(--dim); font-size: 12px; font-variant-numeric: tabular-nums; text-align: right; }

textarea { min-height: 190px; font-family: "Cascadia Mono", Consolas, monospace; font-size: 12px; }
.report {
  background: #10141a; border: 1px solid var(--line); border-radius: 6px;
  padding: 8px; max-height: 260px; overflow: auto; font-size: 12px;
  white-space: pre-wrap; margin-top: 8px;
}
.progress { height: 8px; background: #10141a; border-radius: 4px; overflow: hidden; margin: 8px 0; }
.progress div { height: 100%; width: 0; background: var(--accent); transition: width .2s; }

.setting { display: grid; grid-template-columns: 1fr 120px; gap: 8px; align-items: center; margin: 5px 0; }
.setting label { font-size: 12px; }
.group { border-top: 1px solid var(--line); margin-top: 12px; padding-top: 8px; }
.group h4 { margin: 0 0 6px; font-size: 12px; color: var(--accent); text-transform: uppercase; }
@media (max-width: 1100px) { main { grid-template-columns: 1fr; } }
