# Скомпилированный байт-код. Держать его в репозитории незачем: он
# пересобирается сам, зато конфликтует при каждом слиянии — и разрешать
# такие конфликты бессмысленно, потому что читать там нечего.
__pycache__/
*.py[cod]
*$py.class

# Кэш тестов
.pytest_cache/
.coverage
htmlcov/

# Резервные копии, которые панель делает при правке конфигов
*.bak
*.tmp

# Окружения
.venv/
venv/
env/

# Мусор операционных систем
.DS_Store
Thumbs.db
